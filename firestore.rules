rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role-based access control
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Since we store roles in the 'users' collection, we use get() to check them securely.
    // NOTE: This incurs an extra read per rule evaluation.
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['raviranjan8904@gmail.com', 'futurecodeai@gmail.com', 'killerravi8904@gmail.com'] ||
        getRole() == 'admin' || 
        getRole() == 'super_admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['raviranjan8904@gmail.com', 'futurecodeai@gmail.com', 'killerravi8904@gmail.com'] ||
        (isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isInstitute() {
      return isAuthenticated() && getRole() == 'institute';
    }
    
    function isStudent() {
      return isAuthenticated() && getRole() == 'student';
    }

    // ----------------------------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------------------------
    match /users/{userId} {
      // Users can create their own document, and admins can create student profiles
      allow create: if isOwner(userId) || isAdmin();
      
      // Users can read their own profiles, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can update their own profiles EXCEPT the role field. Admins can update any field.
      allow update: if isAdmin() || 
                       (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // ADMINS, STAFF & AUDIT LOGS
    // ----------------------------------------------------------------------
    match /admins/{adminId} {
      // Admins can read the allow-list
      allow read: if isAdmin();
      // Only Super Admins can add or remove admins
      allow write: if isSuperAdmin();
    }

    match /staff/{staffId} {
      // Admins can read and write all staff records
      // Authenticated users can read/query staff records filtered to their own email (for login allow-list check)
      allow read: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }

    match /adminLogs/{logId} {
      // Admins can read and write audit logs
      allow read, write: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // CONTACT MESSAGES & FAQS
    // ----------------------------------------------------------------------
    match /contactMessages/{msgId} {
      // Anyone can submit a contact message
      allow create: if true;
      // Only admins can read, update, or delete them
      allow read, update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      // Anyone can read FAQs
      allow read: if true;
      // Only admins can manage FAQs
      allow write: if isAdmin();
    }

    match /gallery/{imageId} {
      // Anyone can view the gallery
      allow read: if true;
      // Only admins can upload/modify gallery images
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    match /aboutPage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homeStats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collaborators/{collabId} {
      // Public can only view active and approved collaborators, admins can view all
      allow read: if isAdmin() || (resource.data.isActive == true && resource.data.isApproved == true);
      // Only admins can manage collaborators
      allow write: if isAdmin();
    }

    match /partnershipEnquiries/{enquiryId} {
      // Anyone can submit a partnership enquiry
      allow create: if true;
      // Only admins can read, update, or delete them
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // ENROLLMENTS COLLECTION
    // ----------------------------------------------------------------------
    match /enrollments/{enrollmentId} {
      // Students can read their own enrollments by UID or Email
      // Institutes can read enrollments tied to their specific institute ID or center ID
      allow read: if isAdmin() || 
                     (isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.studentEmail == request.auth.token.email)) ||
                     (isInstitute() && (resource.data.instituteId == request.auth.uid || resource.data.centerId == request.auth.uid));
                     
      // Only admins can manage (create, update, delete) enrollments
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // ENQUIRIES COLLECTION
    // ----------------------------------------------------------------------
    match /enquiries/{enquiryId} {
      // Unauthenticated users (and anyone) can create an enquiry via the public website forms
      allow create: if true;
      
      // Students can read their own submitted enquiries (matching authenticated email or studentId UID)
      // Institutes can read enquiries specifically tagged/assigned to them
      allow read: if isAdmin() || 
                     (isAuthenticated() && (resource.data.email == request.auth.token.email || resource.data.studentId == request.auth.uid)) ||
                     (isInstitute() && (resource.data.instituteId == request.auth.uid || resource.data.centerId == request.auth.uid));
                     
      // Only admins can update or delete enquiries (e.g. changing status)
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // COURSES & BATCHES COLLECTION
    // ----------------------------------------------------------------------
    match /courses/{courseId} {
      // Public can read active courses, institutes can read assigned courses, admins can read all
      allow read: if isAdmin() || 
                     resource.data.isActive == true ||
                     (isInstitute() && (resource.data.instituteId == request.auth.uid || resource.data.centerId == request.auth.uid));
      // Only admins can modify courses
      allow write: if isAdmin();
    }

    match /internships/{internshipId} {
      // Public can read active internships, admins can read all
      allow read: if isAdmin() || resource.data.isActive == true;
      // Only admins can modify internships
      allow write: if isAdmin();
    }
    
    match /batches/{batchId} {
      // Anyone can read batches
      allow read: if true;
      // Only admins can modify batches
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // CERTIFICATES COLLECTION
    // ----------------------------------------------------------------------
    match /certificates/{certId} {
      // Anyone can verify individual certificate by ID (direct get)
      allow get: if true;
      // Students can list their certificates by UID or authenticated email
      allow list: if isAdmin() || (isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.studentEmail == request.auth.token.email));
      // Only admins can issue/modify certificates
      allow write: if isAdmin();
    }

    match /verificationLogs/{logId} {
      // Anyone can create a verification log (via VerifyCertificate search)
      allow create: if true;
      // Only admins can read, update, or delete logs
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // WEBINARS & ATTENDEES (STUDENT DASHBOARD & ADMIN MANAGEMENT)
    // ----------------------------------------------------------------------
    match /webinar_attendees/{attendeeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /webinars/{webinarId} {
      // Prospective and enrolled students can view webinars
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // IN-APP NOTIFICATIONS
    // ----------------------------------------------------------------------
    match /notifications/{notifId} {
      // Users can read and mark their own notifications as read
      allow read, update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.userEmail == request.auth.token.email
      );
      // Admins and system can create, manage, and delete notifications
      allow create, delete: if isAdmin() || isAuthenticated();
    }
  }
}

